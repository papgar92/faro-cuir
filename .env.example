# Copia este archivo a .env y rellena valores reales.
# NUNCA commitees .env (está en .gitignore, y gitleaks lo vigila en CI de todas formas).

# --- Aplicación ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Base de datos (PostgreSQL) ---
# Credenciales que usa también el servicio `db` del docker-compose.
POSTGRES_USER=farocuir
POSTGRES_PASSWORD=changeme_en_local
POSTGRES_DB=farocuir
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cadena de conexión que consume el backend/worker (driver psycopg v3, sync).
# En local con docker compose, POSTGRES_HOST=db (nombre del servicio). Fuera de docker, localhost.
DATABASE_URL=postgresql+psycopg://farocuir:changeme_en_local@db:5432/farocuir

# --- Archivo de documentos crudos ---
# Raíz donde el worker guarda el contenido tal cual lo publicó la fuente (CLAUDE.md 6.5).
# Relativa al directorio de trabajo del proceso (/app dentro de los contenedores).
# El nombre de cada fichero se deriva de su sha256, nunca del título del documento.
ALMACEN_ROOT=data

# --- Archivo en un almacén de objetos compatible con S3 (ADR 0032) ---
# VACÍO = el archivo vive en disco, bajo ALMACEN_ROOT. Es lo que corre en local y en los tests,
# y no hay ninguna prisa por cambiarlo.
# CON BUCKET = el archivo pasa a vivir en el almacén de objetos y ALMACEN_ROOT deja de usarse.
# No es una réplica ni una caché: es el mismo archivo de la 6.5 en otro sitio. Existe para que
# la ingesta pueda correr en un runner de GitHub Actions, cuyo disco se destruye al acabar.
#
# Se configura entero o no se configura: con bucket y sin credenciales el sistema se para y lo
# dice, en vez de escribir el archivo en un disco que va a desaparecer.
#
# `documento.ruta_almacen` guarda la MISMA cadena en los dos destinos, así que cambiar de uno a
# otro no reescribe ninguna fila. Migrar el contenido es copiar el árbol tal cual:
#   rclone copy ./data remoto:archivo-farocuir
ALMACEN_S3_BUCKET=
# Endpoint del proveedor. Se valida al arrancar: HTTPS obligatorio (por ahí van el archivo y la
# credencial que lo firma), sin credenciales en la URL y sin ruta. Es la SEGUNDA excepción
# declarada a la allowlist de url_guard (6.2); la primera es Ollama (ADR 0006).
#   Backblaze B2:  https://s3.eu-central-003.backblazeb2.com   (la región sale de tu cuenta)
#   Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
ALMACEN_S3_ENDPOINT=
# Clave de aplicación con permiso SOLO sobre este bucket. Nada de la clave maestra de la cuenta.
ALMACEN_S3_ACCESS_KEY=
ALMACEN_S3_SECRET_KEY=
# "auto" vale para B2 y R2, que ignoran la región. Un S3 de AWS de verdad querría la suya.
ALMACEN_S3_REGION=auto

# --- Suscriptores (dato de categoría especial, art. 9 RGPD — CLAUDE.md 6.4) ---
# Pepper para el HMAC-SHA256 de los emails. Debe ser un valor aleatorio largo y NO debe
# guardarse nunca en la base de datos: si viviera ahí, se filtraría junto con los datos que
# protege. Sin él, el sistema se niega a hashear (falla cerrado) en vez de guardar un hash
# reversible con un diccionario de direcciones.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUSCRIPTOR_PEPPER=

# --- Panel de revisión: el gate humano (regla de oro 4, ADR 0017) ---
# Hash scrypt de la contraseña del panel. **Nunca la contraseña en claro**, aquí ni en ningún
# sitio: esta variable acaba en el entorno de un contenedor, y el entorno se lee entero desde
# cualquier proceso del mismo contenedor y desde `docker inspect`.
# Generar con:
#   docker compose exec backend python -m scripts.generar_hash_panel
# Sin este valor el panel no abre (falla cerrado): el resto de la API sigue funcionando, pero
# no hay forma de aprobar una alerta, que es exactamente lo que debe pasar.
PANEL_PASSWORD_HASH=
# Duración de la sesión de revisión, en segundos. Una hora por defecto.
PANEL_SESION_TTL_SEGUNDOS=3600
# Techo de intentos de login por minuto. Es un cubo GLOBAL, sin IP ni identificador de
# cliente: la 6.4 prohíbe inventariar direcciones y aquí no se hace ni para defenderse.
PANEL_INTENTOS_POR_MINUTO=10

# --- LLM (ADR 0008) ---
# NO HAY NINGUNA CLAVE DE API, y no es un olvido: el proveedor por defecto es Ollama en
# local, sin clave, sin coste y sin cuota. Si algún día se enchufa un proveedor alojado
# detrás de `ProveedorLLM`, su clave va aquí y NUNCA en el código.
#
# Requisito, una sola vez en la máquina que ejecute el extractor:
#   ollama pull qwen2.5:3b-instruct
LLM_BASE_URL=http://127.0.0.1:11434
# Cambiar de modelo es esta variable, no un refactor. Sube de tamaño solo si el gold set
# demuestra que el pequeño no llega.
LLM_MODELO=qwen2.5:3b-instruct
# Generoso a propósito: en CPU sin GPU dedicada una extracción tarda bastante.
LLM_TIMEOUT_SEGUNDOS=180

# Nota: las variables de firma HMAC de webhooks se añadirán cuando se implemente ese módulo
# (CLAUDE.md 6.6). No se declaran aquí para no anticipar configuración que todavía no
# consume ningún código.
