{
  "name": "farocuir-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend de Faro Cuir: mapa de alertas normativas y observatorio de derechos LGTBI+.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
