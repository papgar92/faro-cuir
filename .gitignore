# Secretos y entorno
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Entorno de conveniencia para ejecutar la suite desde el host sin Docker. NO es el
# entorno de referencia: el de referencia es el contenedor, que es lo que corre el CI.
.venv-local/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# Alembic (los scripts de migración SÍ se versionan; esto son solo artefactos)
backend/alembic/*.pyc

# Node / frontend
node_modules/
dist/
.vite/
frontend/coverage/
*.tsbuildinfo

# Docker
*.local.yml

# Artefactos de datos ingeridos (nunca en el repo, van a almacenamiento propio)
backend/data/
*.pdf
*.xml.bak

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Notas sueltas del humano (ya recogidas en CLAUDE.md seccion 12)
Mejoras.txt

# Informes de apoyo importados a mano (ADR 0025): no son codigo ni archivo.
backend/data/informes-*.json

# Sondeos de usar y tirar. El compose monta `./backend:/app`, asi que un `docker compose cp` a
# /app deja el fichero DENTRO DEL REPOSITORIO, y eso ya ha metido basura tres veces (probe.py,
# dbg.py, ver_gay.py) que ademas rompe `ruff` en la puerta de CI. Convencion: cualquier script
# temporal va con este prefijo y se ignora solo.
backend/scripts/_sondeo_*.py
backend/_sondeo_*.py
